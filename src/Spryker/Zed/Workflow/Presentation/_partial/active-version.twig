<div class="card border border-primary bg-primary-subtle m-b-md" data-qa="workflow-active-version">
    <div class="card-body">
        <div class="card-text active-version">
            <div class="version-icon bg-primary bg-opacity-25">
                <span class="material-symbols-outlined text-primary">check_circle</span>
            </div>
            {% set activeVersionValue  = activeVersion.version is defined ? 'V' ~ activeVersion.version : 'No active version' | trans %}
            <div class="version-information">
                <div>{{ 'Active version' | trans }}</div>
                <strong data-qa="workflow-active-version-number">{{ activeVersionValue }}</strong>
                {% if activeVersion %}
                    {% set activeVersionAuthor = activeVersion.user ? (activeVersion.user.firstName ~ ' ' ~ activeVersion.user.lastName) | trim : '' %}
                    <span class="version-meta" data-qa="workflow-active-version-meta">
                        {{ 'Created by' | trans }} {{ activeVersionAuthor ?: '—' }}
                        · {{ activeVersion.createdAt ? activeVersion.createdAt | date('Y-m-d H:i:s') : '—' }}
                    </span>
                {% endif %}
            </div>
            <div class="d-flex gap-2">
                {% if activeVersion %}
                    <a class="btn btn-sm btn-outline"
                            href="{{ url('/workflow/version/view', {'id-definition': activeVersion.idStateMachineProcessDefinition}) }}"
                            data-qa="workflow-active-version-view">
                        <i class="fa fa-eye"></i> {{ 'View' | trans }}
                    </a>
                {% endif %}
                {% set newVersionParameters = {'id-process': idStateMachineProcess} %}
                {% if activeVersion %}
                    {% set newVersionParameters = newVersionParameters|merge({'id-definition': activeVersion.idStateMachineProcessDefinition}) %}
                {% endif %}
                <a class="btn btn-sm btn-outline"
                        href="{{ url('/workflow/version/create', newVersionParameters) }}"
                        data-qa="workflow-active-version-new-version">
                    <i class="fa fa-plus"></i> {{ 'New version' | trans }}
                </a>
            </div>
        </div>
    </div>
</div>
