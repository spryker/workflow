{% extends '@Gui/Layout/layout.twig' %}

{% block head_css %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ assetsPath('css/spryker-zed-workflow-main.css') }}">
{% endblock %}

{% set widget_title = 'Workflows' | trans %}
{% block section_title %}
    {{ widget_title }}
    {% include '@Workflow/_partial/status-badge.twig' %}
{% endblock %}

{% block action %}
    <a class="btn btn-sm btn-back" href="{{ backLink.url }}">
        <span class="material-symbols-outlined">chevron_left</span> {{ backLink.label | trans }}
    </a>
    {% set versionParameters = {'id-process': idStateMachineProcess, 'id-definition': idStateMachineProcessDefinition} %}
    <a class="btn btn-sm"
       href="{{ url('/workflow/version/create', versionParameters) }}"
       data-qa="workflow-version-edit">
        <span class="material-symbols-outlined">edit</span> {{ 'New version' | trans }}
    </a>
    <a class="btn btn-sm btn-outline"
       href="{{ url('/workflow/version', versionParameters) }}"
       data-qa="workflow-version-list">
        <span class="material-symbols-outlined">history</span> {{ 'Versions' | trans }}
    </a>
    {{ form_start(processActivationForm, {action: processStatusChangeUrl, method: 'POST', attr: {class: 'd-inline'}}) }}
        <button type="submit" class="btn btn-sm{{ isProcessActive ? ' btn-danger' }}"
                data-qa="{{ isProcessActive ? 'workflow-process-deactivate' : 'workflow-process-activate' }}"
                data-confirm="1"
                data-confirm-title="{{ processStatusConfirmation.title | trans(processStatusConfirmation.translationParameters) }}"
                data-confirm-message="{{ processStatusConfirmation.message | trans(processStatusConfirmation.translationParameters) }}"
                data-confirm-button="{{ processStatusConfirmation.confirmButtonLabel | trans }}"
                data-confirm-type="{{ processStatusConfirmation.type }}">{{ processStatusConfirmation.confirmButtonLabel | trans }}</button>
    {{ form_end(processActivationForm) }}
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Workflow graph' | trans } %}
        {% block widget_title_wrapper %}{% endblock %}
        {% block widget_content %}
            {% include '@Workflow/_partial/workflow-information.twig' with {
                editModeEnabled: true,
            } %}
            {% include '@Workflow/_partial/process-edit-form.twig' %}

            {# Unlike the server-drawn graph image this replaced, the read-only builder renders an
               invalid definition too — which is exactly when the errors below need looking at. #}
            {% if not isValid %}
                <div class="alert alert-warning" data-qa="workflow-version-invalid-notice">
                    {{ 'This version is not valid yet. Fix the issues below, then save a new version. The definition is validated again when you activate it.' | trans }}
                </div>
                {% if validationErrors is not empty %}
                    <div class="alert d-block alert-danger" data-qa="workflow-version-validation-errors">
                        <strong>{{ 'The definition has the following errors:' | trans }}</strong>
                        <ul class="m-t-sm m-b-none">
                            {% for error in validationErrors %}
                                <li data-qa="workflow-version-validation-error">
                                    {{ error.message | trans }}
                                    {% if error.stateName %}
                                        <span>({{ 'State' | trans }}: {{ error.stateName }})</span>
                                    {% elseif error.eventName %}
                                        <span>({{ 'Event' | trans }}: {{ error.eventName }})</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            {% endif %}

            <h5>{{ 'Version' | trans }} {{ version }}</h5>
            {% include '@Workflow/_partial/state-machine-builder.twig' with {
                readOnly: true,
                definition: definition,
                initialState: initialState,
                canvasRenderer: canvasRenderer|default(null),
            } only %}
        {% endblock %}
    {% endembed %}

    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Workflow activity' | trans } %}
        {% block widget_content %}
            <div data-qa="workflow-activity">
                {{ instanceTable | raw }}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block footer_js %}
    {{ parent() }}
    <script src="{{ assetsPath('js/spryker-zed-workflow-main.js') }}"></script>
{% endblock %}
