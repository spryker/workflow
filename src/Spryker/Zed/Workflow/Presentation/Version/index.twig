{% extends '@Gui/Layout/layout.twig' %}

{% block head_css %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ assetsPath('css/spryker-zed-workflow-main.css') }}">
{% endblock %}

{% set widget_title = 'Workflows' | trans %}
{% block section_title %}
    {{ widget_title }}
    {% include '@Workflow/_partial/status-badge.twig' %}
{% endblock %}

{% block action %}
    <a class="btn btn-sm btn-back" href="{{ backLink.url }}" data-qa="workflow-versions-back">
        <span class="material-symbols-outlined">chevron_left</span> {{ backLink.label | trans }}
    </a>
{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: widget_title } %}
        {% block widget_title_wrapper %}{% endblock %}
        {% block widget_content %}
            {% if processName %}
                <div class="workflow-parent-context m-b-md">
                    <span class="material-symbols-outlined align-middle m-r-xs">flowchart</span> <strong class="js-workflow-summary-name" data-qa="workflow-summary-name">{{ processName }}</strong>
                </div>
            {% endif %}

            {% include '@Workflow/_partial/active-version.twig' %}

            {{ versionTable | raw }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block footer_js %}
    {{ parent() }}
    <script src="{{ assetsPath('js/spryker-zed-workflow-main.js') }}"></script>
{% endblock %}
