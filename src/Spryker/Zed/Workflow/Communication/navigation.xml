<?xml version="1.0"?>
<config>
    <administration>
        <pages>
            <workflows>
                <label>Workflows</label>
                <title>Workflows</title>
                <bundle>workflow</bundle>
                <controller>process</controller>
                <action>index</action>
                <pages>
                    <workflow-create>
                        <label>Create</label>
                        <title>Create</title>
                        <bundle>workflow</bundle>
                        <controller>process</controller>
                        <action>create</action>
                        <visible>0</visible>
                    </workflow-create>

                    <workflow-version-view>
                        <label>View</label>
                        <title>View</title>
                        <bundle>workflow</bundle>
                        <controller>version</controller>
                        <action>view</action>
                        <visible>0</visible>
                        <pages>
                            <workflow-instance-view>
                                <label>Instance</label>
                                <title>Instance</title>
                                <bundle>workflow</bundle>
                                <controller>instance</controller>
                                <action>view</action>
                                <visible>0</visible>
                            </workflow-instance-view>
                        </pages>
                    </workflow-version-view>

                    <workflow-versions>
                        <label>Versions</label>
                        <title>Versions</title>
                        <bundle>workflow</bundle>
                        <controller>version</controller>
                        <action>index</action>
                        <visible>0</visible>
                    </workflow-versions>

                    <workflow-version-create>
                        <label>New Version</label>
                        <title>New Version</title>
                        <bundle>workflow</bundle>
                        <controller>version</controller>
                        <action>create</action>
                        <visible>0</visible>
                    </workflow-version-create>
                </pages>
            </workflows>
        </pages>
    </administration>
</config>
