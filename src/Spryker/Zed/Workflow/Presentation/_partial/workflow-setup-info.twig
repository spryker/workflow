
{% set isSetupInfoHidden = app.request.cookies.get('workflow-setup-info-visibility') == 'hidden' %}

<div class="js-workflow-wrapper"{% if isSetupInfoHidden %} style="display: none;"{% endif %}>
    <div class="card">
        <div class="card-header">
            <span class="material-symbols-outlined">info</span>
            <h5 class="card-title">{{ 'Set up a workflow in 3 steps' | trans }}</h5>
            <h6 class="card-subtitle text-body-secondary">{{ 'Automate what happens after an event fires.' | trans }}</h6>
            <div class="card-action">
                <button type="button" class="js-toggle-info-visibility-button js-hide-info-visibility-button card-action-item btn btn-outline-dark btn-icon">
                    <span class="material-symbols-outlined">close_small</span>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row align-content-start">
                <div class="col col-12 col-lg-4">
                    <div class="row">
                        <div class="col col-auto"><span class="material-symbols-outlined">stacks</span></div>
                        <div class="col col--expand">
                            <h5><span class="text-primary mr-1">1.</span> {{ 'Create a process' | trans }}</h5>
                            <p class="text-body-secondary">{{ 'Pick the object it runs on — e.g. a Customer or Order.' | trans }}</p>
                        </div>
                    </div>
                </div>
                <div class="col col-12 col-lg-4">
                    <div class="row">
                        <div class="col col-auto"><span class="material-symbols-outlined">account_tree</span></div>
                        <div class="col col--expand">
                            <h5><span class="text-primary mr-1">2.</span> {{ 'Add a version' | trans }}</h5>
                            <p class="text-body-secondary">{{ 'Design the states and transitions, then save a version.' | trans }}</p>
                        </div>
                    </div>
                </div>
                <div class="col col-12 col-lg-4">
                    <div class="row">
                        <div class="col col-auto"><span class="material-symbols-outlined">electric_bolt</span></div>
                        <div class="col col--expand">
                            <h5><span class="text-primary mr-1">3.</span> {{ 'Set triggers & activate' | trans }}</h5>
                            <p class="text-body-secondary">{{ 'Choose the event that starts it, then switch it to Active.' | trans }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<button class="btn btn-ghost-primary mb-2 js-toggle-info-visibility-button js-show-info-visibility-button"{% if not isSetupInfoHidden %} style="display: none;"{% endif %}>{{ 'Show how this works' | trans }}</button>
