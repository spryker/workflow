{
    "name": "spryker/workflow",
    "type": "library",
    "description": "Workflow module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/data-import": "^1.27.1",
        "spryker/gui": "^5.3.2",
        "spryker/kernel": "^3.84.0",
        "spryker/log": "^3.20.0",
        "spryker/propel-orm": "^1.16.0",
        "spryker/state-machine": "^2.26.0",
        "spryker/symfony": "^3.15.0",
        "spryker/transfer": "^3.27.0",
        "spryker/util-text": "^1.6.0",
        "spryker/uuid-behavior": "^1.3.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/console": "*",
        "spryker/propel": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/",
            "SprykerTest\\": "tests/SprykerTest/",
            "SprykerTest\\Zed\\Workflow\\Helper\\": "tests/SprykerTest/Zed/Workflow/_support/Helper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spryker\\": "src/Spryker/",
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
